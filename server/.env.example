# Copy this to .env (locally) or set as Railway/Render env vars

# MUST match the secret in core/license.py
AXIS_LICENSE_SECRET=AXIS-OS-LICENSE-2024-V1

# Secret key for /api/v1/admin/stats — set any random string you'll remember
ADMIN_KEY=my-secret-admin-key-2024

# Your AI provider API keys — these stay SERVER-SIDE only, never exposed to clients
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
XAI_API_KEY=xai-...
DEEPSEEK_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...
